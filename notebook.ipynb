    "res_c = results.copy()\n",
    "res_c[\"pos_numeric\"] = pd.to_numeric(res_c[\"positionText\"], errors=\"coerce\")\n",
    "classified_all = res_c.dropna(subset=[\"pos_numeric\"])  # classified finisher = numeric positionText\n",
    "pit_counts_all = pits.groupby([\"raceId\", \"driverId\"]).size().reset_index(name=\"n_stops\")\n",
    "\n",
    "race_eligibility = {}\n",
    "for rid in candidate_race_ids:\n",
    "    cls = classified_all[classified_all.raceId == rid][[\"driverId\"]]\n",
    "    pc = pit_counts_all[pit_counts_all.raceId == rid]\n",
    "    merged = cls.merge(pc, on=\"driverId\")\n",
    "    merged = merged[merged[\"n_stops\"] >= 1]\n",
    "    eligible = []\n",
    "    for drv in merged[\"driverId\"]:\n",
    "        combined, _counts = clean_driver_laps_noleak(rid, drv, laps, pits)\n",
    "        if combined is not None and len(combined) > 0:\n",
    "            eligible.append((int(drv), int(len(combined))))\n",
    "    race_eligibility[rid] = eligible\n",
    "\n",
    "good_races = [rid for rid, pool in race_eligibility.items() if len(pool) >= 5]\n",
    "print(f\"Races with >=5 leak-free-eligible drivers (classified, >=1 stop, non-empty train+test): {len(good_races)}\")\n"
