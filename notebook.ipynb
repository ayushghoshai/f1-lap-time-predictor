    "scores = []\n",
    "for rid in good_races:\n",
    "    ldf = laps[laps[\"raceId\"] == rid].copy()\n",
    "    pdf = pits[pits[\"raceId\"] == rid]\n",
    "    pit_laps_set = set(zip(pdf[\"driverId\"], pdf[\"lap\"]))\n",
    "    ldf[\"is_pit\"] = ldf.apply(lambda r: (r[\"driverId\"], r[\"lap\"]) in pit_laps_set, axis=1)\n",
    "    scan = ldf[~ldf[\"is_pit\"]]\n",
    "    med = scan.groupby(\"driverId\")[\"milliseconds\"].median()\n",
    "    scan = scan.join(med.rename(\"med\"), on=\"driverId\")\n",
    "    scan[\"ratio\"] = scan[\"milliseconds\"] / scan[\"med\"]\n",
    "    anomalous = scan[scan[\"ratio\"] > 1.5]\n",
    "    ndrivers = scan[\"driverId\"].nunique()\n",
    "    per_lap_anom = anomalous.groupby(\"lap\")[\"driverId\"].nunique()\n",
    "    mass_events = int((per_lap_anom >= max(3, 0.3 * ndrivers)).sum())\n",
    "    # Coefficient of variation of the field's per-driver median lap times: std/mean of the\n",
    "    # SAME population (the per-driver medians). The previous version divided that std by the\n",
    "    # median of all pooled individual laps -- a different, mismatched population, and a median\n",
    "    # in the denominator rather than a mean -- which is not a coefficient of variation at all.\n",
    "    driver_medians = scan.groupby(\"driverId\")[\"milliseconds\"].median()\n",
    "    cv = float(driver_medians.std() / driver_medians.mean())\n",
    "    scores.append((rid, ndrivers, mass_events, cv, len(scan)))\n",
    "\n",
    "sdf = pd.DataFrame(scores, columns=[\"raceId\", \"ndrivers\", \"mass_events\", \"cv\", \"n_clean_laps\"])\n",
    "sdf = sdf.merge(races[[\"raceId\", \"year\", \"name\", \"date\"]], on=\"raceId\")\n",
    "sdf = sdf.sort_values([\"mass_events\", \"cv\"]).reset_index(drop=True)\n",
    "sdf.head(10)\n"
   ]
  },
