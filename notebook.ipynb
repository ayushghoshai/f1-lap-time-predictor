    "def add_tire_age(df, pit_lookup):\n",
    "    out = []\n",
    "    for drv, g in df.groupby(\"driverId\"):\n",
    "        pit_laps = pit_lookup[drv]\n",
    "        g = g.sort_values(\"lap\").copy()\n",
    "        tire_age = []\n",
    "        for L in g[\"lap\"]:\n",
    "            prior = [p for p in pit_laps if p < L]\n",
    "            last_pit = max(prior) if prior else 0\n",
    "            tire_age.append(L - last_pit)\n",
    "        g[\"tire_age\"] = tire_age\n",
    "        out.append(g)\n",
    "    return pd.concat(out, ignore_index=True)\n",
    "\n",
    "clean = add_tire_age(clean, pit_lap_lookup)\n",
    "clean[\"grid\"] = clean[\"driverId\"].map(grid_map)\n",
    "clean[\"lap_time_ms\"] = clean[\"milliseconds\"]\n",
    "\n",
    "_sample_drv = SELECTED_DRIVERS[0]\n",
    "_first_pit = pit_lap_lookup[_sample_drv][0]\n",
    "_first_retained = clean[(clean.driverId == _sample_drv) & (clean.stint_id == 1)].sort_values(\"lap\").iloc[0]\n",
    "print(f\"Driver {_sample_drv}: pit lap = {_first_pit}, first retained lap of stint 1 = {int(_first_retained['lap'])}, \"\n",
    "      f\"tire_age = {int(_first_retained['tire_age'])} (expected 2)\")\n",
    "\n",
    "clean[[\"driverId\", \"lap\", \"stint_id\", \"tire_age\", \"grid\", \"lap_time_ms\"]].head(10)\n"
   ]
